{
  "name": "nyeocare",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "create-owner": "node scripts/create-owner.js",
    "test:scan": "node --experimental-specifier-resolution=node --experimental-default-type=module scripts/scan-regression.js",
    "test:critical-ui": "node scripts/critical-ui-regression.js",
    "test": "npm run test:scan && npm run test:critical-ui",
    "test:persistence": "node scripts/persistence-regression.js",
    "test:review-surface": "node scripts/review-surface-regression.js",
    "test:system-scale": "node scripts/system-scale-regression.js",
    "test:aria": "node scripts/aria-proactive-regression.js && node scripts/aria-intelligence-regression.js && npm run test:aria-v2",
    "test:auth": "node scripts/auth-session-regression.js",
    "test:aria-organizational-intelligence": "node scripts/aria-organizational-intelligence-regression.js",
    "test:aria-v2": "node scripts/aria-organizational-intelligence-v2-regression.js"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@supabase/supabase-js": "2.39.8",
    "@vercel/functions": "3.9.7",
    "fuse.js": "7.0.0",
    "twilio": "4.23.0",
    "formidable": "3.5.1",
    "googleapis": "133.0.0",
    "pg": "8.13.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/cli": "8.0.0",
    "pdfjs-dist": "4.10.38",
    "sharp": "0.34.3",
    "@capacitor/android": "8.0.0"
  }
